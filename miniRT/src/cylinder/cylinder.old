#include "../../minirt.h"
static void check_cap(t_ray ray, t_vec3 cap_center, t_vec3 normal,
    double radius, double *best_t)
{
    double  denom;
    double  t;
    t_vec3  to_hit;

    denom = vec3_dot(ray.direction, normal);
    // If ray is parallel to the cap, it misses
    if (fabs(denom) < 0.000001)
        return ;
    
    t = vec3_dot(vec3_sub(cap_center, ray.origin), normal) / denom;
    
    // THE FIX: Use 0.001 instead of 0 to prevent shadow acne!
    if (t <= 0.001 || t >= *best_t)
        return ;
        
    to_hit = vec3_sub(ray_at(ray, t), cap_center);
    if (vec3_dot(to_hit, to_hit) <= (radius * radius))
        *best_t = t;
}

static bool	validate_hit_height(t_ray ray,
	t_cylinder cylinder, double t, double *out_t)
{
	t_vec3	hit_point;
	t_vec3	hit_to_center;
	double	height;

	hit_point = ray_at(ray, t);
	hit_to_center = vec3_sub(hit_point, cylinder.center);
	height = vec3_dot(hit_to_center, cylinder.axis_v);
	if (height >= -cylinder.height / 2 && height <= cylinder.height / 2)
	{
		*out_t = t;
		return (true);
	}
	return (false);
}

static bool	calculate_cylinder_quadratic(t_ray ray,
	t_cylinder	cylinder, t_quadratic *q)
{
	double	dot_dir_axis;
	double	dot_oc_axis;

	cylinder.axis_v = vec3_normalize(cylinder.axis_v);
	q->oc = vec3_sub(ray.origin, cylinder.center);
	dot_dir_axis = vec3_dot(ray.direction, cylinder.axis_v);
	q->a = vec3_dot(ray.direction, ray.direction)
		- (dot_dir_axis * dot_dir_axis);
	if (fabs(q->a) < 0.000001)
		return (false);
	dot_oc_axis = vec3_dot(q->oc, cylinder.axis_v);
	q->b = 2.0 * (vec3_dot(q->oc, ray.direction)
			-(dot_oc_axis * dot_dir_axis));
	q->radius = cylinder.diameter / 2;
	q->c = vec3_dot(q->oc, q->oc) - (dot_oc_axis * dot_oc_axis)
		- (q->radius * q->radius);
	q->discriminant = q->b * q->b - 4.0 * q->a * q->c;
	if (q->discriminant < 0)
		return (false);
	return (true);
}

bool    is_cylinder_hit(t_ray ray, t_cylinder cylinder, double *t)
{
    t_quadratic    q;
    double         sqrt_d;
    double         t1;
    double         t2;
    double         temp;
    double         best_t = INFINITY;

    // THE FIX: Normalize the axis before doing ANY math!
    cylinder.axis_v = vec3_normalize(cylinder.axis_v);

    if (calculate_cylinder_quadratic(ray, cylinder, &q))
    {
        sqrt_d = sqrt(q.discriminant);
        t1 = (-q.b - sqrt_d) / (2.0 * q.a);
        t2 = (-q.b + sqrt_d) / (2.0 * q.a);
        if (t1 > t2)
        {
            temp = t1;
            t1 = t2;
            t2 = temp;
        }
        if (t1 > 0.001 && validate_hit_height(ray, cylinder, t1, &temp))
            best_t = t1;
        else if (t2 > 0.001 && validate_hit_height(ray, cylinder, t2, &temp))
            best_t = t2;
    }
    
    // Now these caps will be placed perfectly flush with the body
    check_cap(ray, vec3_add(cylinder.center, vec3_scale(cylinder.axis_v, cylinder.height / 2.0)), 
        cylinder.axis_v, cylinder.diameter / 2.0, &best_t);
        
    check_cap(ray, vec3_sub(cylinder.center, vec3_scale(cylinder.axis_v, cylinder.height / 2.0)), 
        vec3_scale(cylinder.axis_v, -1.0), cylinder.diameter / 2.0, &best_t);

    if (best_t != INFINITY)
    {
        *t = best_t;
        return (true);
    }
    return (false);
}
