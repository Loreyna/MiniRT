01 - Esfera en el origen

A 0.2 255,255,255
C 0,0,10 0,0,-1 70
L 5,5,10 1.0 255,255,255

sp 0,0,0 4 255,0,0



02 - Plano con z = 0

A 0.2 255,255,255
C 0,0,10 0,0,-1 70 /*0,3,10 0,-0.2,-1 70*/
L 5,5,10 1.0 255,255,255

pl 0,0,0 0,0,1 220,220,220



03 - Cilindro eje Y

A 0.2 255,255,255
C 0,0,10 0,0,-1 70
L 5,5,10 1.0 255,255,255

cy cy 0,0,0 0,1,0 2 10 0,255,0


04 - Dos esferas

