07 - Varias esferas y cilindros

A 0.2 255,255,255
C 0,2,18 0,-0.1,-1 70
L 8,10,8 1.0 255,255,255

pl 0,-3,0 0,1,0 180,180,180

sp -4,0,0 3 255,0,0
sp 4,0,0 3 0,0,255

cy -2,0,-6 0,1,0 1.5 6 0,255,0
cy 3,0,-5 0,1,0 1.5 6 255,255,0


